OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna

# backend
JWT_SECRET=change-me-to-a-random-32-byte-or-longer-secret
APPLE_BUNDLE_ID=com.example.glucose

# backend: Cloudflare R2 (S3 호환). 로컬 개발은 비워두면 docker-compose.local.yml의 MinIO를 기본값으로 쓴다
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PHOTOS=glucose-photos