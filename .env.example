OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=luna

# ml-service
FOOD_MODEL=luna
INTERNAL_TOKEN=dev-token

# backend
# 로컬용은 openssl rand -base64 48 로 새로 만든다. 서버용과 같은 값을 쓰지 않는다
JWT_SECRET=change-me-to-a-random-32-byte-or-longer-secret
APPLE_CLIENT_ID=com.glubee.glubee
# ml-service와 같은 값이어야 한다 (위 INTERNAL_TOKEN과 동일하게)
ML_INTERNAL_TOKEN=dev-token

# backend: Cloudflare R2 (S3 호환). 로컬 개발은 비워두면 docker-compose.local.yml의 s3mock을 기본값으로 쓴다
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PHOTO_BUCKET=glucose-photos
